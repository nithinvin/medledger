{
  "name": "medledger-api",
  "version": "0.1.0",
  "private": true,
  "description": "MedLedger REST API gateway to the Hyperledger Fabric network",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@hyperledger/fabric-gateway": "^1.12.1",
    "@hyperledger/fabric-protos": "^0.3.7",
    "express": "^5.2.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:live": "MEDLEDGER_LIVE=1 node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/live.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
